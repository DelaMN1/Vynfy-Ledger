FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=replace-with-32-plus-random-characters
SECURITY_PASSWORD_SALT=replace-with-another-32-plus-random-characters
DATABASE_URL=sqlite:///instance/vynfy_ledger.db
ACCESS_SESSION_MINUTES=45
SESSION_ROTATE_AFTER_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15
MAX_FAILED_LOGINS=5
REGISTRATION_ENABLED=true
FORCE_HTTPS=false
MAIL_FROM=no-reply@vynfy.internal
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
COMPANY_NAME=Vynfy
