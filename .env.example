FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=replace-with-a-random-64-character-secret
SECURITY_PASSWORD_SALT=replace-with-a-second-random-64-character-secret
DATABASE_URL=postgresql+psycopg://<user>:<password>@localhost:5432/vynfy_ledger
ACCESS_SESSION_MINUTES=45
SESSION_ROTATE_AFTER_MINUTES=15
LOGIN_LOCKOUT_BASE_MINUTES=1
MAX_LOGIN_LOCKOUT_MINUTES=60
MAX_FAILED_LOGINS=10
PASSWORD_RESET_MINUTES=15
ADMIN_STEP_UP_MINUTES=15
REGISTRATION_ENABLED=true
FORCE_HTTPS=false
TRUST_PROXY_COUNT=0
COMPANY_NAME=Vynfy
